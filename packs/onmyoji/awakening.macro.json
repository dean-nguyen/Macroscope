{
  "name": "Onmyoji - Awakening Dungeon",
  "description": "Auto-repeat Awakening Dungeon. Resilient poll: STOPS on a verification/CAPTCHA screen (anti-ban), on a full inventory, and when AP runs out. Dismisses confirm popups and reward screens on its own. Start it ON the activity screen.",
  "background": true,
  "target_window": "Onmyoji",
  "target_class": "Win32Window",
  "loop": true,
  "loop_delay_ms": 2500,
  "actions": [
    {
      "type": "image_check",
      "template": "templates/onmyoji_captcha.png",
      "threshold": 0.7,
      "on_found": [
        {
          "type": "stop"
        }
      ]
    },
    {
      "type": "image_check",
      "template": "templates/onmyoji_inventory_full.png",
      "threshold": 0.7,
      "on_found": [
        {
          "type": "stop"
        }
      ]
    },
    {
      "type": "image_check",
      "template": "templates/onmyoji_out_of_stamina.png",
      "threshold": 0.7,
      "on_found": [
        {
          "type": "stop"
        }
      ]
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_reconnect_retry.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    },
    {
      "type": "image_check",
      "template": "templates/onmyoji_level_up.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "click",
          "xp": 0.593,
          "yp": 0.6063
        },
        {
          "type": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "type": "image_check",
      "template": "templates/onmyoji_defeat.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "click",
          "xp": 0.593,
          "yp": 0.6063
        },
        {
          "type": "wait",
          "ms": 1200
        }
      ]
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_reward_confirm.png",
      "threshold": 0.76,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_challenge_again.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": [
        {
          "type": "find_and_click",
          "template": "templates/onmyoji_battle_ready.png",
          "threshold": 0.8,
          "on_found": [
            {
              "type": "wait",
              "ms": 1200
            }
          ],
          "on_not_found": []
        }
      ]
    }
  ]
}
