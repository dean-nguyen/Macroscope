{
  "name": "Onmyoji - Claim Mail",
  "description": "One-shot: clear the mailbox with Read All (which is what collects attachments on this client) and dismiss the reward screen. Open the MAILBOX first — this macro does not navigate.",
  "background": true,
  "target_window": "Onmyoji",
  "loop": false,
  "actions": [
    {
      "type": "image_check",
      "template": "templates/onmyoji_captcha.png",
      "threshold": 0.7,
      "on_found": [
        {
          "type": "stop"
        }
      ]
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_mail_claim.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_reward_confirm.png",
      "threshold": 0.76,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    }
  ]
}
