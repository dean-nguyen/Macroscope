{
  "name": "Onmyoji - Daily Sign-in",
  "description": "One-shot: claim the daily sign-in reward. Open the SIGN-IN screen first — this macro does not navigate.",
  "background": true,
  "target_window": "Onmyoji",
  "target_class": "Win32Window",
  "loop": false,
  "actions": [
    {
      "type": "image_check",
      "template": "templates/onmyoji_captcha.png",
      "threshold": 0.7,
      "on_found": [
        {
          "type": "stop"
        }
      ]
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_signin_claim.png",
      "threshold": 0.8,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "find_and_click",
      "template": "templates/onmyoji_reward_confirm.png",
      "threshold": 0.76,
      "on_found": [
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "on_not_found": []
    }
  ]
}
